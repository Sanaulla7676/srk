rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this specific account (the store owner) may write — being
    // merely "signed in" isn't enough, since Firebase's Email/Password
    // sign-up endpoint is publicly callable by anyone with the project's
    // API key (which is not a secret). Locking to one UID is what
    // actually keeps random visitors from editing the catalog.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'bwwzJ2JCJESqGiqyUwewVjgwXz22';
    }

    // Storefront data: anyone can read (needed to render the site),
    // only the store owner can create/edit/delete.
    match /products/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /slides/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /coupons/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /auditLogs/{docId} {
      allow read: if isOwner();
      allow create: if true;
      allow update, delete: if isOwner();
    }

    // Orders now belong to a real signed-in customer (customerId == their
    // uid). A customer can read/create/update only their own orders
    // (update covers things like requesting a return); the store owner
    // can read, update, or delete any order for the pipeline view.
    match /orders/{docId} {
      allow read, update: if isOwner() || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow delete: if isOwner();
    }

    // Customer profile docs: a customer manages only their own; the store
    // owner can read any of them (e.g. to see a name against an order).
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isOwner();
    }

    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
