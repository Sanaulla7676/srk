rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this specific account (the store owner) may write — being
    // merely "signed in" isn't enough, since Firebase's Email/Password
    // sign-up endpoint is publicly callable by anyone with the project's
    // API key (which is not a secret). Locking to one UID is what
    // actually keeps random visitors from editing the catalog.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'bwwzJ2JCJESqGiqyUwewVjgwXz22';
    }

    // Storefront data: anyone can read (needed to render the site),
    // only the store owner can create/edit/delete.
    match /products/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /slides/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /coupons/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /auditLogs/{docId} {
      allow read: if isOwner();
      allow create: if true;
      allow update, delete: if isOwner();
    }

    // Orders: any customer can place an order (no customer accounts
    // exist yet, so order history is store-wide rather than per-user,
    // matching the app's current behavior) — only the store owner can
    // change or cancel an order's status.
    match /orders/{docId} {
      allow read, create: if true;
      allow update, delete: if isOwner();
    }

    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
